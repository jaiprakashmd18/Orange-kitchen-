# ═══════════════════════════════════════════════════════════════════════
#  EASY SETUP: you don't need this file. Connect Supabase via the Vercel
#  integration, open your site's /setup page, and paste the other keys in
#  Admin → Integrations. Everything below is OPTIONAL and, when set,
#  overrides the values entered in the admin.
#
#  Orange Kitchen — environment-variable setup (advanced)
#  Add these in Vercel → Project → Settings → Environment Variables
#  (or copy to .env.local for local use) and deploy. The build will
#  migrate the database, create the admin login and configure Auth.
# ═══════════════════════════════════════════════════════════════════════

# ─── 1. Supabase (Project Settings → API) ─── set automatically by the Vercel ↔ Supabase integration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY — bypasses Row Level Security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# supabase.com/dashboard/account/tokens — the build uses it to create the
# database tables and to set the Site URL / redirect URLs.
# Optional: you can paste it in the /setup page instead.
SUPABASE_ACCESS_TOKEN=
# Optional alternative: Supabase → Connect → "Session pooler" URI.
SUPABASE_DB_URL=

# ─── 2. First admin login ─── optional (the /setup page creates it) ────
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Orange Kitchen Admin

# ─── 3. Razorpay (Account & Settings → API Keys) ─── optional ──────────
# (or paste in Admin → Integrations; not needed if you use UPI to your own UPI ID)
# Use rzp_test_… keys until the merchant account is verified and tested.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=
# Optional: Webhooks → https://<your-site>/api/webhooks/razorpay
# (payments are also confirmed by signature check + automatic reconciliation)
RAZORPAY_WEBHOOK_SECRET=

# ─── Site URL (optional on Vercel — the production domain is detected) ─
NEXT_PUBLIC_SITE_URL=

# ─── Optional alternative for order emails: Resend (instead of SMTP) ────
RESEND_API_KEY=
EMAIL_FROM="Orange Kitchen <orders@your-verified-domain.in>"

# ─── Optional: WhatsApp Cloud API ──────────────────────────────────────
# Approved template with 3 body params: {{1}} order no, {{2}} status, {{3}} tracking URL
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# ─── Optional: better automatic dish photos ──────────────────────────────
# Without these, photos come from Wikimedia Commons (no key needed).
PIXABAY_API_KEY=
PEXELS_API_KEY=

# ─── Recommended: send emails from your Gmail (or any SMTP) ─────────────
# Used for sign-up / login / password-reset emails (applied to Supabase by the
# build when SUPABASE_ACCESS_TOKEN is set) AND for order update emails.
# Gmail: turn on 2-Step Verification, create an App Password at
# myaccount.google.com/apppasswords and paste it (16 letters, no spaces).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourname@gmail.com
SMTP_PASS=
SMTP_SENDER_EMAIL=yourname@gmail.com
SMTP_SENDER_NAME=Orange Kitchen

# ─── Optional: secures the daily upkeep job (works without it, throttled)
CRON_SECRET=

# ─── Optional: third-party delivery partner APIs ────────────────────────
# For a partner with env prefix PORTER (Admin → Delivery partners):
# PORTER_API_KEY=
# PORTER_WEBHOOK_SECRET=

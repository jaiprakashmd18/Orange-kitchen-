{
  "name": "orange-kitchen",
  "version": "1.0.0",
  "private": true,
  "description": "Orange Kitchen — restaurant website and online food ordering platform (Surapet, Chennai)",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/setup.mjs --build && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts tests/*.test.mts",
    "db:test": "bash scripts/test-migrations.sh",
    "icons": "node scripts/generate-icons.mjs",
    "build:app": "next build",
    "setup": "node scripts/setup.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "framer-motion": "^11.18.2",
    "leaflet": "^1.9.4",
    "next": "^15.5.28",
    "nodemailer": "^10.3.1",
    "postgres": "^3.4.5",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
